# ==============================================================================
# AI Trading Intelligence Platform (.gitignore)
# Never commit secrets, credentials, local runtime state, or build artifacts.
# ==============================================================================

# Environment & Secrets (NEVER commit real values)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
claude_desktop_config.json

# Legacy local CLI trader runtime directory
trader/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Node.js / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/

# Logs & Diagnostics
logs/
*.log
celerybeat-schedule*

# OS & IDEs
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

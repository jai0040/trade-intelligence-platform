# ==============================================================================
# AI Trading Intelligence Platform — Environment Template (.env.example)
# Copy to `.env` for local development and replace ALL placeholders.
# NEVER commit `.env` or real secrets to Git.
# ==============================================================================

# --- Application & Runtime ---
APP_ENV=development                          # development | staging | production
APP_NAME=TradeIntelligencePlatform
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
TRADING_MODE=SIGNALS_ONLY                    # HARD-LOCKED: SIGNALS_ONLY (no live broker execution)

# --- Security & Cryptography ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_64_BYTE_RANDOM_SECRET
# Generate Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SESSION_COOKIE_NAME=tip_session
SESSION_COOKIE_SECURE=false                  # MUST be true in staging/production (HTTPS)
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=24
CSRF_COOKIE_NAME=tip_csrf
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_intelligence
POSTGRES_USER=tip_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://tip_app:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/trade_intelligence

# --- Valkey / Redis (Sessions, Distributed Locks, Celery Broker, Pub/Sub) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Market Data Providers (Pluggable Interfaces) ---
# Allowed values: mock | licensed_india | licensed_us | dev_yahoo (dev_yahoo blocked in production)
MARKET_DATA_PROVIDER_IN=mock
MARKET_DATA_PROVIDER_US=mock
QUOTE_STALE_THRESHOLD_SECONDS=900            # 15 minutes max age for risk/entry checks
SIGNAL_STALE_THRESHOLD_SECONDS=300           # 5 minutes max age for intraday signal triggers

# Licensed India Market Data Vendor (e.g., TrueData / Global Datafeeds / Authorized Partner)
INDIA_DATA_PROVIDER_API_KEY=REPLACE_WITH_LICENSED_INDIA_API_KEY
INDIA_DATA_PROVIDER_API_SECRET=REPLACE_WITH_LICENSED_INDIA_API_SECRET
INDIA_DATA_PROVIDER_BASE_URL=https://api.india-provider.example

# Licensed US Market Data Vendor (e.g., Polygon / Databento / Alpaca Business / Twelve Data)
US_DATA_PROVIDER_API_KEY=REPLACE_WITH_LICENSED_US_API_KEY
US_DATA_PROVIDER_API_SECRET=REPLACE_WITH_LICENSED_US_API_SECRET
US_DATA_PROVIDER_BASE_URL=https://api.us-provider.example

# SEC EDGAR (Mandatory for trader-analyst and trader-news US 8-K filings)
SEC_USER_AGENT="TradeIntelligencePlatform compliance@example.com"

# --- AI Analyst (Explanations & Synthesis ONLY — Never Overrides Math/Risk) ---
LLM_PROVIDER=mock                            # mock | anthropic | gemini | openai
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=REPLACE_WITH_MODEL_NAME
LLM_MAX_TOKENS_PER_REQUEST=1024

# --- Payments: Razorpay (India / INR) ---
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# --- Payments: Stripe (International / USD) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Notifications (Email & Web Push) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=alerts@example.com
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:alerts@example.com

# --- Super Admin Bootstrap (First-run seed only; rotate immediately after setup) ---
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD

# --- Frontend Public Variables ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/stream
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
